{
  "name": "@aarivbuildz/htmlclean",
  "version": "0.1.0",
  "description": "Zero-dependency allowlist HTML sanitizer for server and edge runtimes, with a real tokenizer and canonical serializer",
  "type": "module",
  "license": "MIT",
  "main": "./cjs/index.cjs",
  "module": "./src/index.mjs",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.mjs",
      "require": "./cjs/index.cjs"
    }
  },
  "files": [
    "src/",
    "cjs/",
    "types/",
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "GOOD_FIRST_ISSUES.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "node scripts/build-cjs.mjs",
    "test": "node scripts/run-tests.mjs tests/*.test.mjs",
    "test:all": "node scripts/build-cjs.mjs && node scripts/run-tests.mjs tests/*.test.mjs"
  },
  "dependencies": {},
  "devDependencies": {},
  "keywords": [
    "html",
    "sanitizer",
    "sanitize",
    "xss",
    "owasp",
    "allowlist",
    "edge",
    "zero-dependency",
    "dompurify-alternative",
    "sanitize-html-alternative"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/draarivpatel-ui/htmlclean.git"
  },
  "bugs": {
    "url": "https://github.com/draarivpatel-ui/htmlclean/issues"
  },
  "homepage": "https://github.com/draarivpatel-ui/htmlclean#readme",
  "publishConfig": {
    "access": "public"
  }
}
